# Copy this file to .env and fill in the values. Keep .env private: it contains API keys.
#
# Create an API key in each tenant under Settings > API Keys, using an admin user.
# API URL: https://api.monetizeplatform.com (US) or https://api-eu.monetizeplatform.com (EU).

# Tenant to export the catalog FROM
SOURCE_API_KEY=
SOURCE_API_URL=https://api.monetizeplatform.com

# Tenant to import the catalog INTO
TARGET_API_KEY=
TARGET_API_URL=https://api.monetizeplatform.com
